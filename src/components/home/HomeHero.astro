---
import HomeFeature from './HomeFeature.astro';
import en from '../../data/home/en.json';
import es from '../../data/home/es.json';

type Image = {
  src: string;
  alt: string;
};

const content: any = Astro.currentLocale === 'es' ? es : en;
---

<div class="home-content">
    <div class="home-container">
        <h1 class="home-container__title">
          {content.hero.title}
        </h1>

        <p class="home-container__text">
          {content.hero.paragraphOne}
        </p>

        <p class="home-container__text">
            {content.hero.paragraphTwo}
        </p>
    </div>
</div>

<HomeFeature title={content.architecture.title} reverse>
  <div 
    slot="visual" 
    class={`feature-gallery feature-gallery--${Math.min(content.architecture.images.length, 4)}`}
  >
    {content.architecture.images.map((image: Image) => (
      <img
        class="feature-gallery__image"
        src={image.src}
        alt={image.alt}
      />
    ))}
  </div>

  <p>{content.architecture.paragraphOne}</p>
  <p>{content.architecture.paragraphTwo}</p>
</HomeFeature>

<HomeFeature title={content.frontend.title}>
  <div 
    slot="visual" 
    class={`feature-gallery feature-gallery--${Math.min(content.frontend.images.length, 4)}`}
  >
    {content.frontend.images.map((image: Image) => (
      <img
        class="feature-gallery__image"
        src={image.src}
        alt={image.alt}
      />
    ))}
  </div>

  <p>{content.frontend.paragraphOne}</p>
  <p>{content.frontend.paragraphTwo}</p>
</HomeFeature>

<HomeFeature title={content.backend.title} reverse>
  <div 
    slot="visual" 
    class={`feature-gallery feature-gallery--${Math.min(content.backend.images.length, 4)}`}
  >
    {content.backend.images.map((image: Image) => (
      <img
        class="feature-gallery__image"
        src={image.src}
        alt={image.alt}
      />
    ))}
  </div>

  <p>{content.backend.paragraphOne}</p>
  <p>{content.backend.paragraphTwo}</p>
</HomeFeature>

<HomeFeature title={content.persistence.title}>
  <div 
    slot="visual" 
    class={`feature-gallery feature-gallery--${Math.min(content.persistence.images.length, 4)}`}
  >
    {content.persistence.images.map((image: Image) => (
      <img
        class="feature-gallery__image"
        src={image.src}
        alt={image.alt}
      />
    ))}
  </div>

  <p>{content.persistence.paragraphOne}</p>
  <p>{content.persistence.paragraphTwo}</p>
  <p>{content.persistence.paragraphThree}</p>
</HomeFeature>

<HomeFeature title={content.testing.title} reverse>
  <div 
    slot="visual" 
    class={`feature-gallery feature-gallery--${Math.min(content.testing.images.length, 4)}`}
  >
    {content.testing.images.map((image: Image) => (
      <img
        class="feature-gallery__image"
        src={image.src}
        alt={image.alt}
      />
    ))}
  </div>

  <p>{content.testing.paragraphOne}</p>
  <p>{content.testing.paragraphTwo}</p>
</HomeFeature>

<HomeFeature title={content.automatedTesting.title}>
  <div 
    slot="visual" 
    class={`feature-gallery feature-gallery--${Math.min(content.automatedTesting.images.length, 4)}`}
  >
    {content.automatedTesting.images.map((image: Image) => (
      <img
        class="feature-gallery__image"
        src={image.src}
        alt={image.alt}
      />
    ))}
  </div>

  <p>{content.automatedTesting.paragraphOne}</p>
  <p>{content.automatedTesting.paragraphTwo}</p>
</HomeFeature>

<style lang="scss">
  .home-content {
    display: flex;
    align-items: center;
    min-height: clamp(1rem, 40svh, 20rem);
  }

  .home-container {
    max-width: var(--content-width-md);
    padding-block: var(--space-8);
    padding-inline-start: clamp(1rem, 3vw, 2.5rem);
    border-inline-start: var(--border-width-lg) solid var(--color-primary);

    &__title {
      margin: 0 0 var(--space-8);
      color: var(--color-text);
      font-size: var(--font-size-heading-md);
      line-height: var(--line-height-tight);
      letter-spacing: var(--letter-spacing-tight);
    }

    &__text {
      max-width: 60ch;
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--font-size-lg);
      line-height: var(--line-height-body);

      & + & {
        margin-block-start: var(--space-4);
      }

      &:first-of-type {
        color: var(--color-text);
        font-size: var(--font-size-xl);
        font-weight: var(--font-weight-medium);
      }
    }
  }

  .feature-gallery {
    position: relative;
    width: 100%;
    height: clamp(18rem, 32vw, 28rem);

    &__image {
      position: absolute;
      display: block;
      width: 46%;
      height: 42%;
      object-fit: cover;
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-surface);
      box-shadow: var(--shadow-md);

      &:nth-child(1) { top: 0; left: 5%; }
      &:nth-child(2) { top: 12%; right: 2%; }
      &:nth-child(3) { bottom: 12%; left: 12%; }
      &:nth-child(4) { right: 10%; bottom: 0; }
    }

    &--1 &__image {
      inset: 5%;
      width: 90%;
      height: 90%;
    }

    &--2 &__image {
      top: 15%;
      bottom: auto;
      width: 58%;
      height: 65%;

      &:first-child { left: 0; }
      &:last-child { left: auto; right: 0; }
    }

    &--3 &__image {
      width: 48%;
      height: 46%;

      &:nth-child(1) { top: 0; left: 0; }
      &:nth-child(2) { top: 8%; right: 0; left: auto; }
      &:nth-child(3) {
        top: auto;
        bottom: 0;
        left: 26%;
      }
    }
  }

  @media (max-width: 36rem) {
    .feature-gallery {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2);
      height: auto;

      &__image {
        position: static;
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 3;
      }

      &--1 {
        grid-template-columns: 1fr;
      }

      &--1 &__image,
      &--2 &__image,
      &--3 &__image {
        width: 100%;
        height: auto;
      }
    }
  }
</style>
