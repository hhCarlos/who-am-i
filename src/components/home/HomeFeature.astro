---
interface Props {
  title: string;
  reverse?: boolean;
}

const { title, reverse = false } = Astro.props;
---

<section class:list={['feature', { 'feature--reverse': reverse }]}>
  <div class="feature__content">
    <h2 class="feature__title">{title}</h2>

    <div class="feature__body">
        <slot />
    </div>
  </div>

  <div class="feature__visual">
    <slot name="visual" />
  </div>
</section>

<style lang="scss">
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    grid-template-areas: 'visual content';
    align-items: center;
    gap: var(--space-12);
    padding-block: var(--space-16);

    &__content {
        display: grid;
        gap: var(--space-8);
    }

    &__title {
        margin: 0;
        color: var(--color-text);
        font-size: var(--font-size-heading-sm);
        line-height: var(--line-height-heading);
        padding: var(--space-2) 0;
        border-bottom: var(--border-width-md) solid var(--color-primary);
    }

    &__body {
        display: grid;
        gap: var(--space-5);
        max-width: 60ch;
        color: var(--color-text-secondary);
        font-size: var(--font-size-lg);
        line-height: var(--line-height-body);

        :global(p) {
            margin: 0;
        }
    }

    &__visual {
      grid-area: visual;
    }

    &--reverse {
      grid-template-areas: 'content visual';
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
  }

  @media (max-width: 48rem) {
    .feature,
    .feature--reverse {
      grid-template-columns: 1fr;
      grid-template-areas:
        'content'
        'visual';
    }
  }
</style>
