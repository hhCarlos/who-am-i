---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Icon, { type IconName } from '../../ui/icon/Icon.astro';

const locale = Astro.currentLocale === 'es' ? 'es' : 'en';
const otherLocale = locale === 'en' ? 'es' : 'en';

const labels = {
  en: {
    home: 'Home',
    projects: 'Projects',
    about: 'About me',
    contact: 'Contact',
    language: 'Ver en español',
    theme: 'Change theme',
    navigation: 'Main navigation',
  },
  es: {
    home: 'Inicio',
    projects: 'Proyectos',
    about: 'Sobre mí',
    contact: 'Contacto',
    language: 'View in English',
    theme: 'Cambiar tema',
    navigation: 'Navegación principal',
  },
}[locale];

const homeHref = getRelativeLocaleUrl(locale, '');
const languageHref = getRelativeLocaleUrl(otherLocale, '');

const normalizePath = (path: string) => path.replace(/\/$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);

const navigationItems = [
  { label: labels.home, href: homeHref, available: true },
  { label: labels.projects, href: getRelativeLocaleUrl(locale, 'projects'), available: false },
  { label: labels.about, href: getRelativeLocaleUrl(locale, 'about'), available: false },
  { label: labels.contact, href: getRelativeLocaleUrl(locale, 'contact'), available: false },
];

const actionsItems = [
  {
    label: 'GitHub',
    action: 'url',
    iconName: 'github',
    url: 'https://github.com/hhCarlos',
    available: true,
  },
  {
    label: 'LinkedIn',
    action: 'url',
    iconName: 'linkedin',
    url: 'https://linkedin.com/in/carlos-enrique-hernandez-hernandez-65aa5433a',
    available: true,
  },
  {
    label: labels.language,
    action: 'language',
    iconName: 'world',
    url: languageHref,
    available: true,
  },
  {
    label: labels.theme,
    action: 'theme',
    iconName: 'theme',
    available: true,
  },
];

const isActive = (href: string): boolean => {
  const path = normalizePath(href);
  return currentPath === path || (path !== '/' && currentPath.startsWith(`${path}/`));
};
---

<script>
  function handleAction(event: MouseEvent) {
    const button = event.currentTarget as HTMLButtonElement;

    if (button.dataset.action === 'theme') {
      const root = document.documentElement;
      const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';

      root.dataset.theme = nextTheme;
      localStorage.setItem('who-am-i-theme', nextTheme);
    }
  }

  document
    .querySelectorAll<HTMLButtonElement>('.navbar__action[data-action]')
    .forEach((button) => button.addEventListener('click', handleAction));
</script>

<nav
  class="navbar"
  aria-label="Navegación principal"
>
  <ul class="navbar__list">
    <li class="navbar__item navbar__item--brand">
      <a
        class="navbar__brand"
        href="/"
        aria-label="Ir al inicio"
      >
        <span class="navbar__title">
          Who Am I
        </span>
      </a>
    </li>

    {
      navigationItems
        .filter(({ available }) => available)
        .map(({ label, href }) => {
          const active = isActive(href);

          return (
            <li class="navbar__item">
              <a
                class:list={[
                  'navbar__link',
                  { 'navbar__link--active': active },
                ]}
                href={href}
                aria-current={active ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          );
        })
    }

    <li class="navbar__item navbar__item--actions">
      {
        actionsItems
          .filter(({ available }) => available)
          .map((item) =>
            item.action === 'url' || item.action === 'language' ? (
              <a
                class="navbar__action"
                href={item.url}
                aria-label={item.label}
                target={item.action === 'url' ? '_blank' : undefined}
                rel={item.action === 'url' ? 'noopener noreferrer' : undefined}
              >
                <Icon name={item.iconName as IconName} />
              </a>
            ) : (
              <button
                type="button"
                class="navbar__action"
                data-action={item.action}
                aria-label={item.label}
              >
                <Icon name={item.iconName as IconName} />
              </button>
            )
          )
      }
    </li>
  </ul>
</nav>

<style lang="scss">
.navbar {
  z-index: var(--z-sticky);
  position: fixed;
  top: 0;
  left: 0;

  width: 100%;
  padding: var(--space-4);

  background-color: var(--color-surface);
  border-bottom: solid 0.3125rem var(--color-primary);
  box-shadow: var(--shadow-md);

  &__list {
    display: flex;
    align-items: center;
    gap: var(--space-6);

    margin: 0;
    padding: 0;

    list-style: none;
  }

  &__item {
    &--brand {
      // margin-right: auto;
    }
  }

  &__item:last-child {
    display: flex;
    margin-left: auto;
    gap: var(--space-4);
  }

  &__action {
    transform: scale(1);
    transition: ease-in .2s;
    color: var(--color-primary);

    &:hover {
      transform: scale(1.2);
      color: var(--color-secondary);
      box-shadow: var(--shadow-sm);
    }
  }

  &__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-semibold);
  }

  &__link {
    position: relative;

    padding-block: var(--space-2);

    color: var(--color-text-secondary);
    font-weight: var(--font-weight-medium);
    text-decoration: none;

    transition: var(--transition-color);

    &:hover,
    &:focus-visible {
      color: var(--color-primary);
    }

    &::after {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;

      height: 0.125rem;

      background-color: var(--color-primary);

      content: '';
      transform: scaleX(0);
      transform-origin: center;
      transition: var(--transition-transform);
    }

    &--active {
      color: var(--color-primary);
      font-weight: var(--font-weight-semibold);

      &::after {
        transform: scaleX(1);
      }
    }
  }
}
</style>
